# --- State backend (vercel-blob-tfstate) ---
# Vercel Blob read/write token - this is where the Terraform state actually lives.
# Create a Blob store at https://vercel.com/dashboard/stores and copy its token.
BLOB_READ_WRITE_TOKEN=

# --- Provider credentials ---
# tofu reads these as environment variables. Load them into your shell before
# running tofu with:  set -a; source .env; set +a
TF_VAR_supabase_access_token=
TF_VAR_render_api_key=
